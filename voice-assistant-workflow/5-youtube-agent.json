    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// One clean result object back to the Main Architect (never crash)\nlet r = { ok: true, workflow: \"YouTube Agent\", operation: 'unknown', summary: '', voice_reply: '', needs_confirmation: false, missing_info: '' };\ntry {\n  const items = $input.all();\n  const j = items[items.length - 1].json;\n  const agent = $('Specialist Agent').item.json;\n  r.operation = agent.operation || r.operation;\n  r.needs_confirmation = !!agent.needs_confirmation;\n  r.missing_info = agent.missing_info || '';\n  r.voice_reply = agent.voice_reply || '';\n  const d = j.messages || j.data || j.items || j.id || j;\n  r.summary = r.voice_reply || 'Done';\n  if (d && typeof d === 'object') r.details = Array.isArray(d) ? d.slice(0, 10) : d;\n  if (r.missing_info && !r.voice_reply) r.voice_reply = r.missing_info;\n} catch (e) { r.ok = false; r.summary = 'Tool error: ' + String(e); r.voice_reply = \"That didn't work \u2014 I'll try again.\"; }\nreturn [{ json: r }];"
      },
