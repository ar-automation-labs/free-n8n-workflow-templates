        "mode": "runOnceForAllItems",
        "jsCode": "// Parse the task handed over by the Main Architect (error-tolerant)\nconst out = { task: '', ok: true };\ntry {\n  const items = $input.all();\n  const j = items[items.length - 1].json;\n  out.task = String(j.task || j.query || j.text || j.input || JSON.stringify(j)).slice(0, 1500);\n} catch (e) { out.task = String(e); }\nreturn [{ json: out }];"
      },
