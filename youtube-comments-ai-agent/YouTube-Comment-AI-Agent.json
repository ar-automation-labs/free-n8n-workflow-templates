    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst items = $input.all();\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.processed) staticData.processed = {};\nconst now = Date.now();\nfor (const it of items) {\n  const id = it.json.commentId;\n  if (id) staticData.processed[id] = now;\n}\n// keep the dedup map bounded\nconst keys = Object.keys(staticData.processed);\nif (keys.length > 2000) {\n  keys.sort((a, b) => staticData.processed[a] - staticData.processed[b]);\n  for (const k of keys.slice(0, keys.length - 2000)) delete staticData.processed[k];\n}\nreturn items;\n"
      },
