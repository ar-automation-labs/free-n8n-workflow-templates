    {
      "id": "07c1440e-f559-4e1e-9a34-45da80cfad43",
      "name": "Write LinkedIn Post",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1250,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "=RESEARCH: {{ JSON.stringify($('Choose Post Topic').first().json.output) }}\nIDEA: {{ $('Prepare Daily Brief').first().json.idea }}\nNOTES: {{ $('Prepare Daily Brief').first().json.notes }}\nCREATOR: {{ $('YOUR SETTINGS').first().json.creatorName }}\nAUDIENCE: {{ $('YOUR SETTINGS').first().json.audience }}\nVOICE: {{ $('YOUR SETTINGS').first().json.voice }}",
        "messages": {
          "messageValues": [
            {
              "message": "Write a human, interesting LinkedIn post for the creator, in their own voice. Open with a recognisable situation or compelling detail; develop one insight with a useful example or takeaway. Plain natural English, short paragraphs, 90–160 words when appropriate. Do not turn every post into a checklist. No generic AI slogans, hype, buzzwords, forced engagement bait or sales pitch. Never invent personal experience, customers, performance numbers or proof. If the supplied idea includes a genuine free offer, make it natural rather than promotional. Return only the finished post."
            }
          ]
        }
      }
    },
