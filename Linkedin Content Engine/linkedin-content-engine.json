    {
      "id": "898b6d12-680e-48f2-89a2-a2579448d922",
      "name": "Write Image Prompt",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1750,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "=POST: {{ $('Edit LinkedIn Post').first().json.output.final_post }}\nANGLE: {{ $('Choose Post Topic').first().json.output.angle }}\nSTYLE: {{ $('YOUR SETTINGS').first().json.visualStyle }}\nNOTES: {{ $('Prepare Daily Brief').first().json.notes }}",
        "messages": {
          "messageValues": [
            {
              "message": "You are a high-end editorial art director. Create one concrete, memorable visual idea that enhances this post without repeating its whole story. Strong focal subject, clean hierarchy, meaningful composition, professional typography only when truly necessary. Avoid fake software screenshots, invented charts and proof, generic AI robots, floating app icons, flowchart dots, random metaphors, staged offices, notebooks and motivational quotes. Keep visual uncluttered and designed for a mobile feed. Ask for 4:5 portrait and square-safe content; model may determine physical aspect ratio. Return JSON only: image_headline (short concept title), image_prompt (80–130 words of specific scene, composition, art style, light, palette and only essential on-image text)."
            }
          ]
        },
        "hasOutputParser": true
      }
    },
