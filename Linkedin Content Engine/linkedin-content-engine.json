    {
      "id": "1f4499a5-4e3d-4dd9-a881-02f859f8222d",
      "name": "Edit LinkedIn Post",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1500,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "=DRAFT: {{ $json.text }}\nIDEA: {{ $('Prepare Daily Brief').first().json.idea }}\nNOTES: {{ $('Prepare Daily Brief').first().json.notes }}\nRESEARCH: {{ JSON.stringify($('Choose Post Topic').first().json.output) }}\nVOICE: {{ $('YOUR SETTINGS').first().json.voice }}",
        "messages": {
          "messageValues": [
            {
              "message": "Edit like a thoughtful LinkedIn reader. Does the hook earn attention? Is there a real, specific insight beyond generic advice? Rewrite weak material, remove padding, corporate voice, generic AI fluff, needless disclaimers and repetitive formats. Preserve the original subject and creator facts; do not invent proof. Keep factual claims aligned with the verified research. Normally 90–160 words with short readable paragraphs. Score strictly (correct but forgettable is under 8/10). Return only JSON: score, issues (one short sentence), final_post, hook (exact opening paragraph)."
            }
          ]
        },
        "hasOutputParser": true
      }
    },
