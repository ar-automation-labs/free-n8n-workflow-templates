        "emailType": "text",
        "message": "=Call with {{ $json.clientName }} on {{ $json.callDate }}\n\nWhat happened:\n{{ $json.summary }}\n\nNext steps logged: {{ $json.actionCount }}\n\nHow to do better next time:\n{{ $json.coachNote }}\n\n(Full log in your Google Sheet.)",
        "options": {}
